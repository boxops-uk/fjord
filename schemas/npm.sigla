# The **JavaScript package layer** — a repository's workspaces and its resolved dependency
# graph. What `typescript.sigla` filled from a Yarn plugin, in a namespace of its own.
#
# ---- why this is not inside `typescript` ----------------------------------------------
#
# `typescript.sigla`'s header opens with *"two producers, one schema"* — a Yarn plugin fills the
# package layer, an Rspack plugin fills the bundle layer — and then a third arrived with the
# semantic core. Three producers writing into one namespace is the coupling this set is here to
# undo, for three reasons that are not tidiness:
#
#   * **A partial index becomes expressible.** A repository with a lockfile and no TypeScript
#     is an `npm` index and nothing else. Today it would have to declare — and a reader would
#     have to see — a schema promising a semantic layer nobody filled.
#   * **The producers fail independently.** A yarn plugin can complete when tsc OOMs, and a
#     database whose schema says which producers wrote it (`config.Setting {producer}`) can say
#     so.
#   * **It is not TypeScript.** The package graph is the same for a JavaScript, a CSS or a
#     Rust-via-wasm workspace. Naming it `typescript` was an accident of which producer landed
#     first, and the indexer-overhaul plan's own Run 8b draws the identical seam on the .NET
#     side (build facts out from behind the walk).
#
# ---- the model is Yarn's, verbatim ----------------------------------------------------
#
# Using Yarn's own vocabulary means the two agree by construction rather than by translation:
#
#   * a **Locator**    (identifier + *reference*) — a resolved package instance
#     (`react@npm:18.2.0`, `@internal/app@workspace:packages/app`); a node in the tree.
#   * a **Descriptor** (identifier + *range*) — a dependency *requirement* (`react@^18`).
#   * a **Resolution** maps a descriptor to the locator it resolved to (`yarn.lock`).
#   * a **Workspace** is a package that lives in the repo; a **Project** is the tree that owns
#     the lockfile. (`Project` ≈ an MSBuild solution; `Workspace` ≈ a `.csproj`.)
#
# npm and pnpm both fit it — their lockfiles carry the same requirement/resolution split — and
# the namespace is named for the ecosystem rather than the tool for that reason. Where Yarn's
# model is *richer* than theirs, a producer leaves the extra facts unwritten.
#
# **Field order is key order, and key order is the index design** — each predicate leads with
# the field a query seeks on. Identity is the key; attributes are the value.

schema npm {

  import src

  # An interned package identifier (`@scope/pkg`). Kept here rather than shared with the other
  # layers' names: a package identifier and a bundler's chunk name are different string spaces
  # that happen to both be strings, and Glean keeps `Name` per language for the same reason.
  predicate Name : string

  # The search index, lower-cased — a producer writes it (no `prim.toLower` in fjord).
  # `nameLowercase` leads and is not unique, so it is key-only. `codemarkup.SearchEntry`
  # supersedes this for a *user-facing* search box; this is the ecosystem-scoped lookup.
  predicate NameLowerCase : { nameLowercase : string, name : Name }

  # ---- closed vocabularies -------------------------------------------------------------

  type DependencyKind = { prod = 0 | dev = 1 | peer = 2 | optional = 3 }
  type PackageKind    = { workspace = 0 | dependency = 1 }

  # ---- the graph -----------------------------------------------------------------------

  # Yarn's *locator* — a resolved package instance. Both fields are identity: the same name at
  # two references is two packages, which is how versions fall out. `name` leads, so "every
  # version of `react`" is a range.
  predicate Locator : { name : Name, reference : string }

  # Yarn's *descriptor* — a dependency requirement. Both fields identity; `name` leads.
  predicate Descriptor : { name : Name, range : string }

  # yarn.lock's core mapping: a descriptor resolves to exactly one locator.
  predicate Resolution : { descriptor : Descriptor } -> { locator : Locator }

  # A package's manifest facts, keyed by its locator.
  predicate Package : { locator : Locator } -> { kind : PackageKind, manifest : src.File, version : string, private_ : src.Bool }

  # A dependency edge: `dependent` requires `descriptor`, in section `kind`. Joined through
  # `Resolution` this is the resolved tree. `dependent` leads: "this package's dependencies".
  predicate Dependency : { dependent : Locator, descriptor : Descriptor } -> { kind : DependencyKind }

  # The reverse — "who depends on this" — keyed on the depended-on descriptor. Key-only edge.
  predicate Dependent : { descriptor : Descriptor, dependent : Locator }

  # The Yarn project: the tree root that owns the lockfile. (≈ a solution.)
  predicate Project : { root : src.File } -> { lockfile : src.File }

  # A workspace — a package that lives in the repo. `project` leads: "this project's
  # workspaces"; `locator` is its identity; `root` its directory.
  predicate Workspace : { project : Project, locator : Locator } -> { root : src.File }

  # Which package owns a source file, by path. `file` leads: one file, one package.
  predicate FilePackage : { file : src.File } -> { locator : Locator }

  # **A manifest, and the package it declares** — `Package`'s `manifest` field keyed for the other
  # question. `Package` puts the manifest on the value side (identity is the locator), and a value
  # can be neither matched nor read field-wise, so from a `package.json` there was no way back to
  # the package at all.
  #
  # It is also what makes a package reachable from `codemarkup` without a symbol bridge: a
  # `src.Symbol` naming a package resolves through `codemarkup.Definition {symbol, file}` — whose
  # `file` **is** the manifest — and lands here. `msbuild.Project` needs no equivalent because its
  # identity is already its project file.
  predicate PackageManifest : { manifest : src.File, locator : Locator }

  # **A workspace-to-workspace dependency edge, resolved** — the JavaScript answer to
  # "inter-project references", and the thing `Dependency` can only say in two hops (through
  # a `Descriptor` and a `Resolution`).
  #
  # It is stored rather than joined because it is the edge a UI draws: an internal dependency
  # graph over a 200-workspace monorepo is one seek per node here, against two joins and a
  # filter-for-workspace-ness there. `dependent` leads; `kind` trails it so "this workspace's
  # production dependencies on other workspaces" narrows.
  #
  # Would derive as:
  #   npm.WorkspaceDependency {dependent = A, kind = K, dependency = B}
  #     where npm.Dependency {dependent = A, descriptor = D} = {kind = K};
  #           npm.Resolution {descriptor = D} = {locator = B};
  #           npm.Package {locator = B} = {kind = {workspace = _}, ..}
  predicate WorkspaceDependency : { dependent : Locator, kind : DependencyKind, dependency : Locator }

  # The reverse — "which workspaces depend on this one", the direction a refactor asks in.
  predicate WorkspaceDependent : { dependency : Locator, dependent : Locator }

}
