# The C# semantic layer: what Roslyn can see.
#
# Namespaces, the four named-type kinds (class, interface, record, struct), methods, fields,
# parameters, type parameters, locals and properties, plus the definitions, references and
# locations that tie them to source. A fjord translation of Meta Glean's `csharp` schema.
#
# The project and solution graph is `msbuild.sigla`, not this file, and nothing here
# references a project: the join from a declaration to the project that compiled it runs
# `src.Location` -> `src.File` -> `msbuild.SourceFileToProject`. The language-independent
# UI surface is `codemarkup.sigla`; the bridge into it is `SymbolOf`/`DefinitionBySymbol`
# at the end of this file.
#
# ## How Glean's constructs are expressed
#
# fjord's type model is narrower than Glean's, so five constructs are translated, uniformly:
#
#   * `enum { A | B }` becomes a union of empty-payload alternatives with explicit
#     discriminants, `{ a = 0 | b = 1 }`. Alternative names are lowercase, because the
#     grammar's alternative name is a `<lid>`. Discriminants are frozen on disk
#     ([I10](invariants.html#i10)), so the numbering here is the numbering forever.
#   * `bool` becomes the `src.Bool` union. fjord has no boolean primitive.
#   * `byte` becomes `int`. fjord has one integer type, signed 64-bit.
#   * `maybe T` becomes a union `{ nothing = 0 | just : T = 1 }`, one named type per payload,
#     since fjord has no generics.
#   * `[T]` becomes one fact per element — an edge predicate carrying an `index : int` where
#     order matters. A length-prefixed array cannot be prefix-matched, so it would close the
#     seek for every key field after it.
#
# The list rule is why `Method` and `Property` carry `docId`, Roslyn's
# `GetDocumentationCommentId()` (`M:Namespace.Type.Method(System.Int32)`). Glean identifies a
# method by its whole signature including the parameter list, which fjord cannot put in a
# key; `docId` is the C# name that already encodes the parameter types, so it keeps overloads
# distinct without an edge. It sits last in the key because it is a disambiguator, never
# something a query narrows on.
#
# Glean's `stored` derived predicates lose their query bodies: fjord has no schema derivation
# yet, so `NameLowerCase` and everything in `codemarkup` is an ordinary predicate the indexer
# fills, keyed for the lookup it answers.
#
# Field order is key order. Read each predicate as "what is this fast at", and expect a
# reverse-direction question to be its own predicate.

schema csharp {

  import src

  # ---- optionals ------------------------------------------------------------------------

  # `maybe T`, one per payload type; `nothing` is the empty alternative. The ones over this
  # schema's own reference types live here, and `src` owns the ones over primitives.
  type MaybeNamespace                 = { nothing = 0 | just : Namespace = 1 }
  type MaybeClass                     = { nothing = 0 | just : Class = 1 }
  type MaybeRecord                    = { nothing = 0 | just : Record = 1 }
  type MaybeNamedType                 = { nothing = 0 | just : NamedType = 1 }
  type MaybeVariance                  = { nothing = 0 | just : Variance = 1 }
  type MaybeMethod                    = { nothing = 0 | just : Method = 1 }
  type MaybeMethodInvocationExpression = { nothing = 0 | just : MethodInvocationExpression = 1 }

  # ---- names and namespaces ---------------------------------------------------------------

  # An interned identifier. A name is shared, so a reference to one is a `FactId`.
  predicate Name : string

  # The lower-cased search index, written by the indexer. `nameLowercase` leads, because a
  # case-insensitive search box seeks on it.
  predicate NameLowerCase : { nameLowercase : string, name : Name }

  # A namespace and the one it is nested in. The containing namespace is part of the key
  # because `A.B` and `C.B` are different namespaces both named `B`.
  predicate Namespace : { name : Name, containingNamespace : MaybeNamespace }

  # A simple name, the namespace containing it, and how many type parameters it declares.
  # `name` leads, so "the fully-qualified names spelled `Foo`" is a range, and `Foo` in `N`
  # at any arity is one too; `arity` trails, so `Foo<T>` in `N` is an exact seek.
  #
  # **Arity is part of a named type's identity and not a modifier of it.** C# holds `Foo`
  # and `Foo<T>` in one declaration space as two unrelated types, so a key without the
  # count merges them into one fact carrying two `DefinitionLocation` rows — which is
  # exactly the shape a partial class has, and so is never an error.
  predicate FullName : { name : Name, containingNamespace : Namespace, arity : int }

  # ---- closed vocabularies -----------------------------------------------------------------

  # Every accessibility combination Roslyn exposes.
  type Accessibility =
    { friend                = 0
    | internal              = 1
    | notApplicable         = 2
    | private               = 3
    | protected             = 4
    | protectedAndFriend    = 5
    | protectedAndInternal  = 6
    | protectedOrFriend     = 7
    | protectedOrInternal   = 8
    | public                = 9
    }

  # The kinds of method-like symbol. Present for completeness; as in Glean, no predicate here
  # carries a `MethodKind` field yet.
  type MethodKind =
    { anonymousFunction                = 0
    | builtinOperator                  = 1
    | constructor                      = 2
    | conversion                       = 3
    | declareMethod                    = 4
    | delegateInvoke                   = 5
    | destructor                       = 6
    | eventAdd                         = 7
    | eventRaise                       = 8
    | eventRemove                      = 9
    | explicitInterfaceImplementation  = 10
    | functionPointerSignature         = 11
    | lambdaMethod                     = 12
    | localFunction                    = 13
    | ordinary                         = 14
    | propertyGet                      = 15
    | propertySet                      = 16
    | reducedExtension                 = 17
    | sharedConstructor                = 18
    | staticConstructor                = 19
    | userDefinedOperator              = 20
    }

  # How a parameter is passed. `none_` is the plain by-value case — a bare `none` would read
  # as "absent" — and the trailing underscore keeps it a legal name.
  type RefKind = { in = 0 | none_ = 1 | out = 2 | ref = 3 | refReadOnly = 4 }

  # Declared variance of a generic type parameter.
  type Variance = { in = 0 | none_ = 1 | out = 2 }

  # ---- the type system ----------------------------------------------------------------------
  #
  # These three unions are inlined at every use site: what gets stored is the tag and, for the
  # fact-bearing alternatives, a `FactId`. The recursion is broken by reference — an `AType`
  # names predicates rather than embedding them.

  # Any symbol the compiler exposes.
  type Definition =
    { type          : AType         = 0
    | method        : Method        = 1
    | field         : Field         = 2
    | parameter     : Parameter     = 3
    | typeParameter : TypeParameter = 4
    | local         : Local         = 5
    | property      : Property      = 6
    }

  # A type: an array, a named type, a function pointer, a pointer, or a type parameter.
  type AType =
    { arrayType           : ArrayType           = 0
    | namedType           : NamedType           = 1
    | functionPointerType : FunctionPointerType = 2
    | pointerType         : PointerType         = 3
    | typeParameter       : TypeParameter       = 4
    }

  # A type that is neither an array, a pointer, nor a type parameter. The keyword names carry
  # a trailing underscore.
  type NamedType =
    { class_     : Class     = 0
    | interface_ : Interface = 1
    | record_    : Record    = 2
    | struct_    : Struct    = 3
    }

  # ---- the named types ------------------------------------------------------------------------
  #
  # Each is identified by its `FullName`, which leads the key so "the class named X" is a seek.
  # Glean carries type parameters in the key too; here they are edges (`TypeTypeParameter`),
  # because a list cannot lead anything after it in a key.
  #
  # `FullName.arity` is the **scalar summary** of that list, and it completes that decision
  # rather than reversing it: a scalar can sit in a key where a list cannot, so the edges
  # keep the parameters and the key keeps the count. Without the count `Foo` and `Foo<T>`
  # are one fact here, and `TypeTypeParameter` then hangs `T` off the merged entity.

  predicate Class :
    { name                  : FullName
    , baseType              : MaybeClass
    , containingType        : MaybeNamedType
    , declaredAccessibility : Accessibility
    , isAbstract            : src.Bool
    , isStatic              : src.Bool
    , isSealed              : src.Bool
    }

  predicate Interface :
    { name                  : FullName
    , containingType        : MaybeNamedType
    , declaredAccessibility : Accessibility
    , isStatic              : src.Bool
    }

  predicate Record :
    { name                  : FullName
    , baseType              : MaybeRecord
    , containingType        : MaybeNamedType
    , declaredAccessibility : Accessibility
    , isAbstract            : src.Bool
    , isSealed              : src.Bool
    }

  predicate Struct :
    { name                  : FullName
    , containingType        : MaybeNamedType
    , declaredAccessibility : Accessibility
    }

  # An interface a named type implements. `type` leads: "what does this type implement".
  predicate Implements : { type : NamedType, interface_ : Interface }

  # Ordered type parameters of a named type. `type` then `index`, so a type's parameters come
  # back in declaration order from one seek.
  predicate TypeTypeParameter : { type : NamedType, index : int, typeParameter : TypeParameter }

  # ---- methods -------------------------------------------------------------------------------

  # `name` leads, for search by method name; parameters and type parameters are edges;
  # `docId` trails, keeping overloads distinct.
  predicate Method :
    { name                  : Name
    , containingType        : NamedType
    , returnType            : AType
    , isStatic              : src.Bool
    , declaredAccessibility : Accessibility
    , docId                 : string
    }

  # Ordered parameters of a method.
  predicate MethodParameter : { method : Method, index : int, parameter : Parameter }

  # Ordered type parameters of a generic method.
  predicate MethodTypeParameter : { method : Method, index : int, typeParameter : TypeParameter }

  predicate Parameter :
    { name       : Name
    , type       : AType
    , refKind    : RefKind
    , isThis     : src.Bool
    , isParams   : src.Bool
    , isOptional : src.Bool
    }

  predicate Field :
    { name                  : Name
    , type                  : AType
    , containingType        : NamedType
    , declaredAccessibility : Accessibility
    , isConst               : src.Bool
    , isReadonly            : src.Bool
    , isVirtual             : src.Bool
    }

  # Identified by name and its constraints — the structural identity Glean gives it, so two
  # parameters agreeing on all of these are one fact.
  predicate TypeParameter :
    { name                       : Name
    , variance                   : MaybeVariance
    , hasNotNullConstraint       : src.Bool
    , hasReferenceTypeConstraint : src.Bool
    , hasValueTypeConstraint     : src.Bool
    }

  # A local variable in a method body.
  predicate Local :
    { name             : Name
    , type             : AType
    , containingMethod : Method
    , refKind          : RefKind
    , isConst          : src.Bool
    }

  # A property or indexer. Indexer parameters are an edge and accessors are optional; `docId`
  # trails the key for the reason it does on `Method`, since indexers overload by parameter
  # type.
  predicate Property :
    { name           : Name
    , containingType : NamedType
    , type           : AType
    , getMethod      : MaybeMethod
    , setMethod      : MaybeMethod
    , isStatic       : src.Bool
    , isIndexer      : src.Bool
    , docId          : string
    }

  # Ordered indexer parameters of a property.
  predicate PropertyParameter : { property : Property, index : int, parameter : Parameter }

  # ---- the remaining type shapes ----------------------------------------------------------------

  # `rank` was Glean's `byte`; here it is an `int`.
  predicate ArrayType : { elementType : AType, rank : int }

  # A pointer type (`int*`), only in unsafe code.
  predicate PointerType : { pointedAtType : AType }

  # A function pointer type (`delegate*<void>`), whose shape is a method signature.
  predicate FunctionPointerType : { name : FullName, signature : Method }

  # ---- locations -----------------------------------------------------------------------------
  #
  # `src.Location` is a file reference and a span into it, in the position encoding
  # `config.Setting "position-encoding"` declares. Glean bundles a line index in with this;
  # here lines are `src.FileLine`.

  # Where a definition is declared. `definition` leads: "where is this defined".
  predicate DefinitionLocation : { definition : Definition, location : src.Location }

  # Where an object is constructed, and which constructor it calls.
  predicate ObjectCreationLocation : { type : AType, constructor : Method, location : src.Location }

  # Where a method is invoked, and the expression it was invoked through, if any.
  predicate MethodInvocationLocation :
    { method     : Method
    , location   : src.Location
    , expression : MaybeMethodInvocationExpression
    }

  # A method invocation seen through a member access.
  type MethodInvocationExpression = { memberAccess : MemberAccessLocation }

  # Where a member is accessed, and what the accessed member resolves to.
  predicate MemberAccessLocation : { expression : MemberAccessExpression, location : src.Location }

  type MemberAccessExpression =
    { local     : Local     = 0
    | parameter : Parameter = 1
    | field     : Field     = 2
    | property  : Property  = 3
    | method    : Method    = 4
    }

  # Where a type is written — a type reference in source.
  predicate TypeLocation : { type : AType, location : src.Location }

  # ---- cross-references ------------------------------------------------------------------------
  #
  # `MethodInvocationLocation`, `MemberAccessLocation` and `TypeLocation` are Glean's xref
  # facts and they are per-kind: three predicates and three queries to answer "what is at this
  # position". These two are the unified pair, keyed on the `Definition` union.
  #
  # This is the cheap in-database path — the target is a `Definition`, so following it is a
  # `FactId` hop. `codemarkup.FileXRef` is the same relation with a `src.Symbol` target, which
  # costs an interned string and buys the ability to leave this database.
  #
  # Both rely on a union-typed variable being shareable between generators:
  #
  #     csharp.EntityXRef {file = F, use = U, target = D};
  #     csharp.DefinitionLocation {definition = D, location = L}

  # References in a file: a use span and what it targets. `file` then `use`, so a file's
  # references arrive in position order for a renderer to splice. Key-only.
  predicate EntityXRef : { file : src.File, use : src.ByteSpan, target : Definition }

  # The reverse — where is this used. `target` leads, then `file`, so both "everywhere" and
  # "everywhere in this file" are one seek.
  predicate EntityRef : { target : Definition, file : src.File, use : src.ByteSpan }

  # ---- the bridge to codemarkup -------------------------------------------------------------------
  #
  # A way from a global name to the rich C# facts, and back. Both key on `Definition`
  # directly, with the symbol as a trailing key field rather than a value so that a query can
  # carry on joining on it.

  # This definition's global name — the SCIP symbol.
  predicate SymbolOf : { definition : Definition, symbol : src.Symbol }

  # The reverse, and the one that makes a cross-database answer usable: given a symbol from
  # another index, the C# definition it names here. `symbol` leads, so it is a seek.
  predicate DefinitionBySymbol : { symbol : src.Symbol, definition : Definition }

}
