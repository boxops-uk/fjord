# The built-in code index: a source layer, a build layer, and a declaration graph.
#
# Field order is key order. A query can narrow on a leading run of a record's fields and only
# filter on the rest, so where a field sits decides what is fast — read each record as "what
# is this predicate fast at", not as a list of attributes.

schema src {

  # `src.File`, `src.Symbol`, the line table and the shared scalars are declared in
  # `src.sigla`. Exactly one file may declare a name — identical redeclaration is
  # `reject/redeclaration` — so this is an import and not a copy.
  import src

  # ---- the source layer -------------------------------------------------------
  #
  # What a syntax walk can see, on top of what `src.sigla` declares. `example/index.py`
  # fills these with Python's `ast`; everything below them needs a compiler and a build
  # system.

  # The namespace, per file. A file declaring two namespaces is two modules.
  predicate Module : { file : File, name : string }

  # A declaration. `line` goes last because the join anybody writes is "the declarations in
  # this module", often narrowed by name, and the line only distinguishes two declarations
  # that agree on both.
  #
  # The value is the declaration's kind — `def`, `class`, `method` — because it is the one
  # thing a query reads without matching on, and a value cannot be matched
  # ([I6](invariants.html#i6)).
  predicate Decl : { module : Module, name : string, line : int } -> string

  # Where a declaration's name starts and where the whole thing ends. `line` comes from the
  # declaration's key; `col` is where the *name* starts, so a viewer can highlight the
  # identifier rather than the statement, and `endLine`/`endCol` close the declaration, which
  # is what folds a body.
  predicate DeclSpan : { decl : Decl, col : int, endLine : int, endCol : int }

  # The search index over declaration names. A declaration's key begins with its module, so
  # `src.Decl {name = "encode"..}` reaches the name only after the scan has opened; keyed with
  # the name leading, the same prefix is a range.
  predicate SearchByName : { name : string, to : Decl }

  # The same index, lower-cased, since sigla has no `toLower` to apply at read time. A second
  # copy rather than a replacement: "find exactly `Parse`" and "find anything spelled like
  # parse" are different questions.
  predicate SearchByLowerName : { name : string, to : Decl }

  # Find-references: "where is this used" seeks only if the target leads. The file comes
  # second so "this declaration's uses in this file" narrows too, and it is a field of its own
  # because `to` reaches the file the *declaration* is in.
  #
  # `at.length` is how many characters the reference spells, which is what a viewer needs to
  # draw a link over it. It is in the key rather than the value because a key field is already
  # in the register the scan holds where a value is a point read per row
  # ([I6](invariants.html#i6)), and it costs the seeks nothing because it trails.
  predicate Ref : { to : Decl, file : File, at : { line : int, col : int, length : int } }

  # The same references keyed by the file they are in — what a viewer asks once per file, and
  # the one question `src.Ref` cannot answer. Position leads the rest of the key, so a file's
  # references come back in the order a renderer splices them.
  predicate FileXRef : { file : File, at : { line : int, col : int, length : int }, to : Decl }

  # Module to module, deduplicated: what a name in this file resolved to, rather than what a
  # `using` or an `import` statement claimed.
  predicate Import : { from : Module, to : Module }

  # ---- the build layer: what compiled a file, and into what --------------------

  # A `.csproj` path, as a file is a path.
  predicate Project : string

  # An assembly name.
  predicate Assembly : string

  # A project, a target framework, and the assembly the pair produces.
  predicate Compilation : { assembly : Assembly, framework : string, project : Project }

  # Edges, which is how a many-to-many is said without arrays.
  predicate ProjectSource : { file : File, project : Project }
  predicate ProjectRef : { from : Project, to : Project }

  # A compound identity — a package is its name and its version, and neither alone.
  predicate Package : { name : string, version : string }
  predicate PackageRef : { package : Package, project : Project }

  # ---- the declaration graph: what a syntax walk cannot see --------------------
  #
  # All four lead with the end of the edge you fan out *from*, which is the seek:
  # `{base, type}` makes "everything deriving from this" a seek.

  predicate Member : { container : Decl, member : Decl }
  predicate Extends : { base : Decl, type : Decl }
  predicate Implements : { iface : Decl, type : Decl }
  predicate Override : { base : Decl, member : Decl }

  # The other direction, for the question a symbol panel asks: given this type, what does it
  # derive from. `src.Extends` answers "who derives from this", which is the opposite.
  predicate DerivesFrom : { type : Decl, base : Decl }

  # An `int` in the middle of a key, so a method's parameters come back in order.
  predicate Param : { decl : Decl, index : int, name : string } -> string

  # A key of one field, which is what an attribute of something else is.
  predicate TypeOf : { decl : Decl } -> string
  predicate Doc : { decl : Decl } -> string

  # A string leading the key, so `[Obsolete]` everywhere is a seek rather than a scan.
  predicate Attribute : { attribute : string, target : Decl }

  # And the other direction, for the reason `src.DerivesFrom` exists: a panel asks what this
  # declaration is marked with.
  predicate AttributeOf : { target : Decl, attribute : string }

}
