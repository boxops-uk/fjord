<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Boxops.Fjord.Client\Boxops.Fjord.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Buildalyzer runs the design-time build out of process, so a project's real
         compilation inputs — its source list, its references, its preprocessor symbols —
         come from MSBuild itself rather than from a guess about how it is laid out.
         Buildalyzer.Workspaces turns each result into a Roslyn project. -->
    <PackageReference Include="Buildalyzer" Version="9.0.0" />
    <PackageReference Include="Buildalyzer.Workspaces" Version="9.0.0" />
    <!-- Roslyn, newer than the 4.10 Buildalyzer.Workspaces asks for, so that a
         repository written in a recent C# parses as itself. The Visual Basic half is
         here only to keep the set coherent: Buildalyzer.Workspaces depends on it, and
         NuGet is right to refuse a Roslyn whose halves are different versions. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- **The gates have to be able to see what they gate.** The walk's internals are
         internal, and six of the indexer runs state a mechanical gate over them. The write
         half is published in `Boxops.Fjord.Client` now, so what is left behind this is the
         indexer's own machinery; it grants nothing to a consumer. -->
    <InternalsVisibleTo Include="Boxops.Fjord.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The versions above are this project's, stated here. MSBuild walks *up* from a
         project for a `Directory.Packages.props`, so a checkout that happens to sit
         inside some other workspace would otherwise be told what Roslyn to use by a
         file that has never heard of it. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- A large index holds every compilation's symbols while it walks them; the server
         collector is what keeps that from dominating the run. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- MSBuild's own assemblies come from the SDK at run time, and NuGet's advisory
         about a transitive package Buildalyzer pins is not actionable here. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>

    <!-- **Shipped as a tool, because building it from source was the only way to get
         it.** A release carried the `fjord` binary and nothing else, so indexing a
         checkout meant cloning this repository and running it out of the tree.

         A tool package rather than a self-contained binary, and that is not a
         convenience: Buildalyzer runs the design-time build **out of process**, against
         MSBuild assemblies that come from the SDK at run time — the `NoWarn` above is
         about the same fact. A self-contained publish would still refuse to index
         anything on a machine with no SDK, so it would be a standalone binary that is
         not one. Every machine that can index a .NET checkout already has the SDK this
         needs, which is what makes a tool the honest shape.

         `fjord-indexer` is the name its own usage text has always given. -->
    <!-- **Its own version, apart from the repository's, because this package states a
         schema fingerprint and the others do not.** `DotnetIndex.SchemaFingerprint` is
         checked for equality at the handshake, so an installed build carrying the previous
         fingerprint is refused by any server whose `dotnet.sigla` has moved — a breaking
         change for whoever installed it, and the minor is where breaking lives in `0.x`.

         `scripts/check-versions.py` is what requires this to move, and
         `clients/dotnet/PUBLISHED.tsv` is what it compares against. Nothing else in the
         client tree needs to move with it. -->
    <Version>0.7.0</Version>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fjord-indexer</ToolCommandName>
    <PackageId>Boxops.Fjord.Indexer</PackageId>
    <Description>
      Index a .NET solution into a Fjord database — Buildalyzer and Roslyn over a real
      checkout, writing the predicates schemas/dotnet.sigla declares.
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
