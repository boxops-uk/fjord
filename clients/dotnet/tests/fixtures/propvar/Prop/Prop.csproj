<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Property-valued on purpose: the declared-vs-achieved comparison must read what
         this evaluates to, never the literal "$(MyTargets)" text. -->
    <MyTargets>net8.0;net10.0</MyTargets>
    <TargetFrameworks>$(MyTargets)</TargetFrameworks>
  </PropertyGroup>
</Project>
