<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Surface.Types</RootNamespace>

    <!-- Clause 8.9.4 is about the nullable context, and a context has to have a default
         before a `#nullable` directive in a file can be seen to override it. `enable` is
         that default here; Nullability.cs turns it off and on again by hand. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
